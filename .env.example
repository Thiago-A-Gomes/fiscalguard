# Frontend
VITE_API_BASE_URL=http://127.0.0.1:3333

# Backend
SERVER_PORT=3333
NODE_ENV=development
DATABASE_PATH=./data/fiscalguard.db
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Authentication — generate the hash with: npm run hash-password -- "your-password"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=scrypt$replace-with-generated-value
SESSION_TTL_HOURS=8
